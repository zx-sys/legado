APP_NAME=legado-backend
DEBUG=false
API_PREFIX=/api/v1

# MySQL（Docker 部署时 MYSQL_PASSWORD 会被 compose 读取并同时注入 MySQL 与 API）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=legado
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=legado
# 仅 Docker：宿主机映射端口，避免和本机 MySQL 冲突时改这里
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=change-root-me
# 手动指定完整连接串时使用；留空则按上面的 MYSQL_* 拼接
# DATABASE_URL=mysql+pymysql://legado:change-me@127.0.0.1:3306/legado?charset=utf8mb4

# Redis（留空关闭缓存）
# 格式：redis://:密码@主机:端口/库号
REDIS_URL=redis://127.0.0.1:6379/0
# 仅 Docker：宿主机映射端口
REDIS_HOST_PORT=6379
LATEST_CACHE_SECONDS=60

# 阿里云 OSS（四项留空则媒体文件落本地 LOCAL_STORAGE_DIR）
# Endpoint 形如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=legado
# 可选：自定义访问域名，例如 https://cdn.example.com
OSS_PUBLIC_BASE_URL=

# 文件
LOCAL_STORAGE_DIR=storage
MAX_BACKUP_MB=512
KEEP_LATEST_BACKUPS=true

# DeepSeek（兼容 OpenAI /chat/completions 协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# 允许跨域的来源，多个用逗号分隔；* 仅建议在内网调试使用
CORS_ORIGINS=*
