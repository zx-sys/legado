<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <io.legado.app.lib.prefs.PreferenceCategory
        android:title="@string/backup_account"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false"
        app:layout="@layout/view_preference_category">

        <io.legado.app.lib.prefs.EditTextPreference
            android:key="backupServerUrl"
            android:summary="@string/backup_server_url_s"
            android:title="@string/backup_server_url"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.EditTextPreference
            android:key="backupPhone"
            android:summary="@string/backup_phone_s"
            android:title="@string/backup_phone"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.EditTextPreference
            android:key="deviceName"
            android:summary="@string/backup_device_name_s"
            android:title="@string/backup_device_name"
            app:iconSpaceReserved="false" />

    </io.legado.app.lib.prefs.PreferenceCategory>

    <io.legado.app.lib.prefs.PreferenceCategory
        android:title="@string/backup_restore"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false"
        app:layout="@layout/view_preference_category">

        <io.legado.app.lib.prefs.Preference
            android:key="localPassword"
            android:summary="@string/set_local_password_summary"
            android:title="@string/set_local_password"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="backupUri"
            android:summary="@string/select_backup_path"
            android:title="@string/backup_path"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="backupContent"
            android:summary="@string/backup_content_summary"
            android:title="@string/backup_content"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="lan_backup_transfer"
            android:summary="@string/lan_backup_transfer_summary"
            android:title="@string/lan_backup_transfer"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="backupNow"
            android:summary="@string/manual_backup_summary"
            android:title="@string/manual_backup"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="restoreNow"
            android:summary="@string/restore_summary"
            android:title="@string/restore"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="restoreIgnore"
            android:summary="@string/restore_ignore_summary"
            android:title="@string/restore_ignore"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="onlyLatestBackup"
            android:summary="@string/only_latest_backup_s"
            android:title="@string/only_latest_backup_t"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="autoBackup"
            android:title="@string/auto_backup_t"
            app:allowDividerAbove="false"
            app:allowDividerBelow="false"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="true"
            android:key="autoCheckNewBackup"
            android:summary="@string/auto_check_new_backup_s"
            android:title="@string/auto_check_new_backup_t"
            app:iconSpaceReserved="false" />

    </io.legado.app.lib.prefs.PreferenceCategory>

</androidx.preference.PreferenceScreen>
